# Local engine env. campaign.json (repo root) is the source of truth for product parameters —
# fee bps, rollover, symbols, caps, pools, cadence. Keys that mirror it are BLANK here on
# purpose: a value set here silently overrides the sheet.

# safe by default — real buys need DRY_RUN=0
DRY_RUN=1
# campaign start, ms epoch. REQUIRED. Historical fills before this never credit. (Season 1 live: 1788379200000)
START_MS=
END_MS=
# GATES (per the Hence feature-gates doc):
# MEGAPOT_ACTIVE=1 + whitelist = pre-production cohort. Empty whitelist = OPEN TO ALL (needs a users feed). Pause = ACTIVE=0.
MEGAPOT_ACTIVE=0
MEGAPOT_WHITELIST=
USERS_FILE=
# open-mode feeds (app.hence.markets). GRANTS_URL derives from USERS_URL when blank.
USERS_URL=
BASKET_URL=
SPOT_FILLS_URL=
ACTIVE_URL=
GRANTS_URL=
# READ-ONLY feed token (backend HENCE_FEED_TOKEN) — never the admin token; the engine sends it to every feed URL.
USERS_TOKEN=
# qualifying symbols — campaign.json eligibility.symbols is the source of truth (empty = all)
SYMBOLS=
# Hence builder fee bps and rollover share — campaign.json economics is the source of truth
FEE_BPS=
ROLLOVER=
# caps — campaign.json caps + the deploy dispatch (budget_usdc) are the source of truth
MAX_TICKETS_PER_WALLET_PER_DAY=
GLOBAL_BUDGET_USDC=
# cycle seconds — campaign.json hub.engineCycleS (300) is the source of truth
ENGINE_INTERVAL_S=
# gas ceiling for buy txs (gwei); engine uses min(ceiling, 2 x live base fee). Blank = default.
MAX_FEE_GWEI_CEILING=
# retro tickets: Megapot's 12/day TicketNFTs in the pool wallet are transferred to users before USDC buys
TICKET_NFT=
RETRO_TRANSFERS=1
# testnet | mainnet
TARGET=testnet
RPC=
# pool hot wallet (capped!) — funds tickets. Referrer receiving Megapot fees:
PRIVATE_KEY=
TREASURY=
# comms (optional)
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_KEY=
POSTHOG_KEY=
