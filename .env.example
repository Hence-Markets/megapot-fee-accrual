# safe by default — real buys need DRY_RUN=0
DRY_RUN=1
# campaign start, ms epoch. REQUIRED. Historical fills before this never credit.
START_MS=
# enrolled trader wallets, comma-separated (empty = engine refuses to run)
WALLETS=
# qualifying symbols, comma-separated (empty = all symbols qualify, test mode)
SYMBOLS=
# Hence builder fee bps and rollover share (spec v3: 100%)
FEE_BPS=4.5
ROLLOVER=1.0
# caps
MAX_TICKETS_PER_WALLET_PER_DAY=5
GLOBAL_BUDGET_USDC=50
# testnet | mainnet
TARGET=testnet
# pool hot wallet (capped!) — funds tickets. Referrer receiving Megapot fees:
PRIVATE_KEY=
TREASURY=
