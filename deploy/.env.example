# Megapot engine — VM environment.
# Written by neo-hence's deploy-megapot workflow, NOT by hand. Every value empty/safe by default.
#
# campaign.json is the source of truth for PRODUCT parameters (fee bps, rollover, symbols, caps,
# pools, cadence). The keys below that mirror it are left BLANK on purpose: a value here silently
# overrides the sheet, and the deploy workflow strips them from the VM env on every run.

# ── Gates ───────────────────────────────────────────────────────────────────
# READ THE ORDER: START_MS before MEGAPOT_ACTIVE, always. Switching on without a start
# makes every historical fill eligible at once.
MEGAPOT_ACTIVE=0
START_MS=
END_MS=

# Non-empty = pre-production cohort (only these wallets accrue).
# EMPTY = OPEN TO ALL ENROLLED USERS, and the engine refuses to run without a users feed —
# empty means everyone, so it needs USERS_FILE or USERS_URL to know who everyone is.
MEGAPOT_WHITELIST=
USERS_FILE=

# Pause with MEGAPOT_ACTIVE=0. NEVER by clearing the whitelist — that opens it instead.

# ── Backend feeds (open mode) ───────────────────────────────────────────────
# All on app.hence.markets; the deploy workflow pins the host. 'off' in the dispatch removes one.
USERS_URL=
BASKET_URL=
SPOT_FILLS_URL=
ACTIVE_URL=
# Derived from USERS_URL by the engine when unset (…/api/admin/tier-grants). Set only to override.
GRANTS_URL=
# Bearer for the feeds above. Use the READ-ONLY feed token (backend env HENCE_FEED_TOKEN), never
# the admin token: the engine sends this to every feed URL and a compromised engine must not be
# able to export emails or grant tiers. deploy-megapot writes it from secret HENCE_FEED_TOKEN.
USERS_TOKEN=

# ── Safety ──────────────────────────────────────────────────────────────────
# 1 = full state machine, no funds move. Leave at 1 until a supervised first mint.
DRY_RUN=1
# Spend safety stop in USDC. Set per deploy (dispatch input budget_usdc); keep it above the pool
# wallet balance and raise it with each top-up. Live Season 1 value: 1500.
GLOBAL_BUDGET_USDC=
# Per-wallet daily cap — campaign.json caps.ticketsPerWalletPerDay is the source of truth.
MAX_TICKETS_PER_WALLET_PER_DAY=
# Cycle length in seconds — campaign.json hub.engineCycleS (300) is the source of truth. If you
# do override it, raise the compose healthcheck -mmin to 2 x interval as well.
ENGINE_INTERVAL_S=
# Gas: the buy tx fee cap. The engine reads the live base fee and uses min(ceiling, 2 x base fee);
# blank = engine default. Raise only when Base runs hot and buys log "fee above cap".
MAX_FEE_GWEI_CEILING=

# ── Economics — campaign.json is the source of truth; leave BLANK ───────────
FEE_BPS=
ROLLOVER=
SYMBOLS=

# ── Retro tickets ───────────────────────────────────────────────────────────
# Megapot mints 12 TicketNFTs/day to the pool wallet. With RETRO_TRANSFERS=1 the engine hands
# pool-held tickets of the ACTIVE round to users first and only then buys with USDC.
# Base mainnet TicketNFT: 0x48ffe35abb9f4780a4f1775c2ce1c46185b366e4 (campaign.json retro.ticketNft).
TICKET_NFT=
RETRO_TRANSFERS=1

# ── Network ─────────────────────────────────────────────────────────────────
TARGET=testnet
RPC=

# ── Secrets — injected from repo secrets by the workflow, never committed ────
# Pool hot wallet. FUND WITH THE CAMPAIGN BUDGET ONLY, never a treasury key.
PRIVATE_KEY=
# Receives Megapot referral fees (claimReferralFees) — an address, not a key.
TREASURY=
# Comms (optional; engine disables the integration when unset)
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_KEY=
POSTHOG_KEY=
