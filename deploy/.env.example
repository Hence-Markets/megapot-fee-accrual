# Megapot engine — VM environment.
# Set by the set-megapot-env workflow, NOT by hand. Every value empty/safe by default.

# ── Gates ───────────────────────────────────────────────────────────────────
# READ THE ORDER: START_MS before MEGAPOT_ACTIVE, always. Switching on without a start
# makes every historical fill eligible at once.
MEGAPOT_ACTIVE=0
START_MS=
END_MS=

# Non-empty = pre-production cohort (only these wallets accrue).
# EMPTY = OPEN TO ALL ENROLLED USERS, and the engine refuses to run without USERS_FILE —
# empty means everyone, so it needs the feed to know who everyone is.
MEGAPOT_WHITELIST=
USERS_FILE=

# Pause with MEGAPOT_ACTIVE=0. NEVER by clearing the whitelist — that opens it instead.

# ── Safety ──────────────────────────────────────────────────────────────────
# 1 = full state machine, no funds move. Leave at 1 until a supervised first mint.
DRY_RUN=1
MAX_TICKETS_PER_WALLET_PER_DAY=5
GLOBAL_BUDGET_USDC=50
ENGINE_INTERVAL_S=3600

# ── Economics (campaign.json is the real controller; these are overrides) ────
FEE_BPS=4.5
ROLLOVER=1.0
SYMBOLS=

# ── Network ─────────────────────────────────────────────────────────────────
TARGET=testnet
RPC=

# ── Secrets — injected from repo secrets by the workflow, never committed ────
# Pool hot wallet. FUND WITH THE CAMPAIGN BUDGET ONLY, never a treasury key.
PRIVATE_KEY=
# Receives Megapot referral fees (claimReferralFees) — an address, not a key.
TREASURY=
